{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --cache /tmp/npm-cache --no-audit --no-fund && npm run build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production PORT=5000 node dist/index.js",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
